# Copy this file to .env and fill in real values:
#   cp .env.example .env

# --- Database ---
DATABASE_URL="mysql://user:password@localhost:3306/finsight"

# --- Auth ---
# Generate long random strings for both, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Optional: Cookie domain if deploying across subdomains in production (e.g. .yourdomain.com)
COOKIE_DOMAIN=

# --- AI (Cloud or Local Ollama) ---
# Option A: Fast free cloud AI (Recommended for Render/Production - no RAM footprint)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini API (Alternative free cloud provider)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Option C: Local Ollama (Used automatically when no cloud key is provided)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b

# --- Valuation & Refresh Configuration ---
# Live external market APIs have been safely removed per architecture requirements.
# Assets rely on accurate statement imports, fixed deposit accrual, and user manual valuations.
MARKET_DATA_REFRESH_SECONDS=60
