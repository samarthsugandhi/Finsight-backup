# ──────────────────────────────────────────────────────────────────
# FinSight Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────────

# URL the browser uses to call the API (proxied via Next.js rewrites).
# When running locally: use /api (proxied to localhost:5002)
# When deployed to Vercel: use /api (proxied to your backend via vercel.json)
NEXT_PUBLIC_API_URL=/api

# Backend base URL — used server-side by Next.js rewrites.
# Set this in Vercel project settings → Environment Variables.
# Example: https://finsight-backend.railway.app
# Leave as localhost for local development (default in next.config.mjs)
BACKEND_URL=http://localhost:5002

